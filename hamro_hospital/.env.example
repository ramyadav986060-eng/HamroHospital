# Hamro Hospital local development configuration
# Copy to .env for local use. Do not commit real secrets.

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-in-production

# Database: sqlite for development, postgres for production
DJANGO_DB_ENGINE=sqlite
# POSTGRES_DB=hamro_hospital
# POSTGRES_USER=hamro_user
# POSTGRES_PASSWORD=change_me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Redis / Channels / Celery (optional for local, recommended for production)
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# eSewa sandbox defaults
ESEWA_SANDBOX=True
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Email/SMS placeholders
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@hamrohospital.example.np

# Optional fingerprint device endpoint security key
